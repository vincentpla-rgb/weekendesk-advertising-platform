# Copia este fichero a .env.local y rellena con las claves de tu proyecto
# Supabase (Project Settings > API). Nunca se commitea .env.local (ver
# .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Necesaria en el servidor: /auth/callback y /auth/confirm la usan para
# comprobar allowed_emails y crear el primer `profiles` de un usuario nuevo
# (lib/supabase/team-access.ts). Ambas tablas tienen RLS que exige
# is_team_member(), que a su vez exige un `profiles` activo — con la sesión
# del propio usuario esa comprobación es circular, de ahí la clave de
# servicio. Nunca exponer al navegador (sin prefijo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Email (Resend) — CLAUDE.md §2 -----------------------------------------
# Ya configurada en Vercel. Se usa tanto para el envío de presupuestos
# (app/api/proposals/route.ts) como para el magic link del equipo
# (app/api/auth/send-email/route.ts).
RESEND_API_KEY=re_...

# Remitente de todos los emails salientes, con nombre visible. Dominio de
# pruebas de Resend por ahora — el dominio propio de Weekendesk llegará más
# adelante y solo hará falta cambiar esta variable, no el código.
RESEND_FROM_EMAIL="Weekendesk Advertising <onboarding@resend.dev>"

# Secreto de firma del "Send Email Hook" de Supabase Auth (Authentication >
# Hooks > Send Email, en el dashboard del proyecto). Verifica que las
# llamadas a /api/auth/send-email vienen de verdad de Supabase antes de
# mandar el magic link por Resend.
SEND_EMAIL_HOOK_SECRET=whsec_...
