# Copia este fichero a .env.local y rellena con las claves de tu proyecto
# Supabase (Project Settings > API). Nunca se commitea .env.local (ver
# .gitignore).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# No se usa en el código de la app (todo pasa por RLS con la sesión del
# usuario o por las funciones SECURITY DEFINER de la pantalla pública) — se
# deja aquí solo por si hiciera falta para scripts de administración puntuales.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
